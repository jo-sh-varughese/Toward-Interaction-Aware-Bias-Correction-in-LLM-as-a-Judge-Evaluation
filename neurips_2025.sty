%% neurips_2025.sty
%% -------------------------------------------------------------------
%% Drafting-compatible re-implementation of the NeurIPS 2025 style.
%%
%% This file reproduces the NeurIPS single-column layout (5.5in x 9in
%% text block, 10pt Times, small-bold numbered headings, indented
%% abstract) closely enough for writing, internal review, and arXiv
%% posting WITHOUT requiring the official distribution.
%%
%% >>> Before camera-ready, replace this file with the official
%%     `neurips_2025.sty` shipped by the workshop / main conference. <<<
%%
%% Options:
%%   [preprint] - non-anonymous preprint mode (no effect on layout here)
%%   [final]    - camera-ready mode
%%   [review]   - adds line numbers for reviewers
%% -------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2025}[2025/05/01 NeurIPS 2025 drafting layout (reimplementation)]

\newif\if@nrps@final\@nrps@finalfalse
\newif\if@nrps@preprint\@nrps@preprintfalse
\newif\if@nrps@review\@nrps@reviewfalse
\DeclareOption{final}{\@nrps@finaltrue}
\DeclareOption{preprint}{\@nrps@preprinttrue}
\DeclareOption{review}{\@nrps@reviewtrue}
\DeclareOption{nonatbib}{}
\DeclareOption*{}
\ProcessOptions\relax

\RequirePackage[letterpaper,left=1.5in,right=1.5in,top=1in,bottom=1in]{geometry}
\RequirePackage{times}
\RequirePackage{titlesec}
\RequirePackage{titling}

\renewcommand{\normalsize}{\fontsize{10}{12}\selectfont}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt plus 1pt}
\linespread{1.03}

% ---- Title block --------------------------------------------------
\setlength{\droptitle}{-3em}
\pretitle{\begin{center}\LARGE\bfseries}
\posttitle{\par\end{center}\vskip 0.5em}
\preauthor{\begin{center}\normalsize}
\postauthor{\par\end{center}}
\predate{}\date{}\postdate{}

% ---- Abstract ----------------------------------------------------
\renewenvironment{abstract}{%
  \vskip 0.5em
  \begin{center}\normalsize\bfseries Abstract\end{center}
  \vskip 0.3em
  \begingroup
  \setlength{\leftskip}{0.5in}\setlength{\rightskip}{0.5in}\small
}{%
  \par\endgroup\vskip 1.5em
}

% ---- Headings --------------------------------------------------
\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.6ex plus .3ex minus .2ex}{1.0ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.3ex plus .3ex minus .2ex}{0.8ex plus .2ex}
\setcounter{secnumdepth}{3}

% ---- Reviewer line numbers ------------------------------------
\if@nrps@review
  \RequirePackage[mathlines]{lineno}
  \AtBeginDocument{\linenumbers}
\fi

\endinput
